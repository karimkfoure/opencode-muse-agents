{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": true,
    "exactOptionalPropertyTypes": false
  },
  "include": ["src/**/*.ts", "bundle/tools/**/*.ts", "bundle/plugins/**/*.ts", "tests/**/*.ts"]
}
