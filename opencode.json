{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/muse-spark-1.3-contributor",
  "subagent_depth": 2,
  "permission": {
    "skill": {
      "*": "allow"
    }
  },
  "agent": {
    "spark-coordinator": {
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": {
          "*": "deny",
          "spark-worker": "allow",
          "spark-reviewer": "allow"
        }
      }
    },
    "spark-worker": {
      "mode": "subagent",
      "permission": {
        "task": {
          "*": "deny"
        }
      }
    },
    "spark-reviewer": {
      "mode": "subagent",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git diff": "allow",
          "git log*": "allow",
          "git status*": "allow"
        },
        "task": {
          "*": "deny"
        }
      }
    }
  }
}
