{
  "name": "opencode-muse-agents",
  "version": "0.1.0",
  "description": "Muse Code-grade subagent coordination for OpenCode: durable children, ledger mailbox, admission control, bounded results.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "subagents",
    "multi-agent",
    "muse",
    "spark",
    "orchestration"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/karimkfoure/opencode-muse-agents.git"
  },
  "homepage": "https://github.com/karimkfoure/opencode-muse-agents",
  "bugs": {
    "url": "https://github.com/karimkfoure/opencode-muse-agents/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/src/plugin.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bundle"
  ],
  "scripts": {
    "build": "bun build ./src/plugin.ts --outfile ./dist/index.js --target bun --format esm --external @opencode-ai/* --external zod && bunx tsc --declaration --emitDeclarationOnly --outDir ./dist -p tsconfig.build.json",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.31",
    "@opencode-ai/sdk": "1.18.31"
  },
  "devDependencies": {
    "bun-types": "^1.4.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.1"
  }
}
